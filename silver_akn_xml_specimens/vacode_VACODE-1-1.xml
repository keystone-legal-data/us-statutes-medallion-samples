      <section eId="sec_1-1">
        <num>1-1</num>
        <heading>Contents and designation of Code</heading>
        <paragraph eId="sec_1_1__p_1" class="indent-1">
          <num>p_1</num>
          <content>
            <p>The laws embraced in this and the following titles, chapters, articles and sections of this act shall constitute, and be designated and cited as the "Code of Virginia," hereinafter referred to as "the Code" or "this Code."</p>
          </content>
        </paragraph>
