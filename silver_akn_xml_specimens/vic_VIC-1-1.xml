    <body>
      <section eId="sec_1-1">
        <num>1-1</num>
        <heading>Designation and citation of Code</heading>
        <paragraph eId="sec_1-1__para_1" class="indent-1">
          <num>(a)</num>
          <content>
            <p>(a) The laws embraced in the titles herein contained, as amended from time to time, constitute the “Virgin Islands Code.”</p>
          </content>
        </paragraph>
        <paragraph eId="sec_1-1__para_2" class="indent-1">
          <num>(b)</num>
          <content>
            <p>(b) This Code may be cited by the abbreviation “V.I.C.” preceded by the number of the title and followed by the number of the section, chapter, or part in the title.</p>
          </content>
        </paragraph>
      </section>
